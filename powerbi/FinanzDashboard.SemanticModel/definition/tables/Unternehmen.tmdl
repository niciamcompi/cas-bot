	column EBITDA
		dataType: double
		formatString: #,##0
		lineageTag: 2aec3ad5-7178-4e5f-820d-d15ec2c772a2
		summarizeBy: sum
		sourceColumn: EBITDA

		annotation SummarizationSetBy = Automatic

	partition Unternehmen = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(
				        Web.Contents("https://raw.githubusercontent.com/datasets/s-and-p-500-companies-financials/main/data/constituents-financials.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Auswahl = Table.SelectColumns(Header, {"Symbol", "Name", "Sector", "Price", "Price/Earnings", "Dividend Yield", "Market Cap", "EBITDA"}),
				    Umbenannt = Table.RenameColumns(Auswahl, {{"Sector", "Branche"}, {"Price", "Kurs"}, {"Price/Earnings", "KGV"}, {"Dividend Yield", "Dividendenrendite"}, {"Market Cap", "Marktkapitalisierung"}}),
				    Typen = Table.TransformColumnTypes(Umbenannt, {{"Symbol", type text}, {"Name", type text}, {"Branche", type text}, {"Kurs", type number}, {"KGV", type number}, {"Dividendenrendite", type number}, {"Marktkapitalisierung", type number}, {"EBITDA", type number}}, "en-US"),
				    Gics = Table.PromoteHeaders(
				        Csv.Document(
				            Web.Contents("https://raw.githubusercontent.com/datasets/s-and-p-500-companies/main/data/constituents.csv"),
				            [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				        ),
				        [PromoteAllScalars = true]
				    ),
				    Verknuepft = Table.NestedJoin(Typen, {"Symbol"}, Gics, {"Symbol"}, "Gics", JoinKind.LeftOuter),
				    MitSektor = Table.ExpandTableColumn(Verknuepft, "Gics", {"GICS Sector"}, {"Sektor"}),
				    OhneLuecken = Table.ReplaceValue(MitSektor, null, "Unbekannt", Replacer.ReplaceValue, {"Sektor"}),
				    Final = Table.TransformColumnTypes(OhneLuecken, {{"Sektor", type text}})
				in
				    Final

	annotation PBI_ResultType = Table
