table Unternehmen
	lineageTag: d8e7bfb4-1ccb-4b8e-a955-2022dcd16265

	measure 'Anzahl Unternehmen' =
			COUNTROWS(Unternehmen)
		formatString: #,##0
		lineageTag: 2c8a5324-c410-40b7-80a7-7c942b5181ec

	measure 'Marktkap. Total' =
			DIVIDE(SUM(Unternehmen[Marktkapitalisierung]), 1e9)
		formatString: #,##0
		lineageTag: bd240db4-7756-4009-8a09-478c36a7cff3

	measure 'Median KGV' =
			MEDIAN(Unternehmen[KGV])
		formatString: 0.0
		lineageTag: 0eb135ce-d570-41d4-b651-5418e9d596e3

	measure 'Ø Dividendenrendite' =
			AVERAGE(Unternehmen[Dividendenrendite])
		formatString: 0.00%
		lineageTag: 1bf4b409-b5c0-43f2-8270-de6d447502b4

