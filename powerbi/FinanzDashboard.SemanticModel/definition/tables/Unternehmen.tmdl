table Unternehmen
	lineageTag: 04010ce7-e9a3-46df-a8d3-1bdb64faeea2

	measure 'Anzahl Unternehmen' =
			COUNTROWS(Unternehmen)
		formatString: #,##0
		lineageTag: e19aba77-40f2-4e16-9de3-f1a73da23500

	measure 'Marktkap. Total' =
			DIVIDE(SUM(Unternehmen[Marktkapitalisierung]), 1e9)
		formatString: #,##0
		lineageTag: 394e19fb-1804-449b-984b-faff2bb7f89f

	measure 'Median KGV' =
			MEDIAN(Unternehmen[KGV])
		formatString: 0.0
		lineageTag: 79479641-0a1a-46b3-b82b-2be261c209b6

	measure 'Ø Dividendenrendite' =
			AVERAGE(Unternehmen[Dividendenrendite])
		formatString: 0.00%
		lineageTag: fb414bc9-55dd-450b-888e-e482e84c684c

